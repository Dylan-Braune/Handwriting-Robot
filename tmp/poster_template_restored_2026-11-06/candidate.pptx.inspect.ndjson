{"kind":"textbox","id":"sh/u1kfqd8b","slideIndex":0,"position":{"left":111,"top":1210,"width":473,"height":159},"text":"The system corrects uneven lighting and page rotation. It separates the writing into lines and traces the ink into stroke paths.","geometry":"rect","lineWidth":0,"style":{"fontSize":27,"typeface":"Arial","color":"#17212B","alignment":"left"}}
{"kind":"textbox","id":"sh/v2twzipw","slideIndex":0,"position":{"left":1200,"top":1160,"width":370,"height":48},"text":"Recognition","geometry":"rect","lineWidth":0,"style":{"fontSize":38,"typeface":"Arial","color":"#246A9D","bold":true,"alignment":"left"}}
