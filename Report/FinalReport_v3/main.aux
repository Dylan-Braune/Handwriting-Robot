\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Layer shapes and parameters of the writer classifiers. Batch normalisation adds 2\,176 non-trainable running statistics, so the network holds $966\,445+2\,176=968\,621$ numbers, and the stored checkpoint holds 968\,633 of them in 89 arrays, the twelve extra entries being the per-layer batch counters that play no part in the forward pass, together with one further array carrying the thirteen writer names. The earlier figure of 968\,330 was the total of the ten-writer system, whose smaller head had 13\,354 rather than 13\,645 parameters. A forward pass needs about $3.79\times 10^9$ multiply--accumulate operations.}}{98}{table.caption.77}\protected@file@percent }
\newlabel{tab:wid-layers}{{16}{98}{Layer shapes and parameters of the writer classifiers. Batch normalisation adds 2\,176 non-trainable running statistics, so the network holds $966\,445+2\,176=968\,621$ numbers, and the stored checkpoint holds 968\,633 of them in 89 arrays, the twelve extra entries being the per-layer batch counters that play no part in the forward pass, together with one further array carrying the thirteen writer names. The earlier figure of 968\,330 was the total of the ten-writer system, whose smaller head had 13\,354 rather than 13\,645 parameters. A forward pass needs about $3.79\times 10^9$ multiply--accumulate operations}{table.caption.77}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17}{\ignorespaces Lines of the shape classifier. The ink classifier uses the same split but its counts may differ slightly, because no lines are lost to the stroke normalisation.}}{98}{table.caption.79}\protected@file@percent }
\newlabel{tab:wid-data}{{17}{98}{Lines of the shape classifier. The ink classifier uses the same split but its counts may differ slightly, because no lines are lost to the stroke normalisation}{table.caption.79}{}}
\@writefile{lot}{\contentsline {table}{\numberline {18}{\ignorespaces Training settings of the two writer classifiers. \textbf  {The whole shape-classifier column describes the superseded frozen-head run} --- 500 epochs, batches of 64 pre-computed feature vectors, 3\,680 stored vectors and only the 13\,645 head parameters trained --- which is the configuration that reached 83.36\,\% and that the fault analysis above refers to. It is \emph  {not} a description of the deployed shape classifier, which is trained end-to-end on images with all 966\,445 parameters and reaches 93.67\,\%; the settings of that end-to-end run were not recorded, and neither was the best epoch or the number of epochs actually run for either set of stored weights.}}{98}{table.caption.81}\protected@file@percent }
\newlabel{tab:wid-hyper}{{18}{98}{Training settings of the two writer classifiers. \textbf {The whole shape-classifier column describes the superseded frozen-head run} --- 500 epochs, batches of 64 pre-computed feature vectors, 3\,680 stored vectors and only the 13\,645 head parameters trained --- which is the configuration that reached 83.36\,\% and that the fault analysis above refers to. It is \emph {not} a description of the deployed shape classifier, which is trained end-to-end on images with all 966\,445 parameters and reaches 93.67\,\%; the settings of that end-to-end run were not recorded, and neither was the best epoch or the number of epochs actually run for either set of stored weights}{table.caption.81}{}}
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Evidence for the writer classifiers. Chance level for thirteen writers is 7.7\,\%. The two classifiers are complementary and neither is redundant: the ink classifier is the correct instrument for real photographs and the normalised classifier for drawn output.}}{99}{table.caption.83}\protected@file@percent }
\newlabel{tab:wid-results}{{19}{99}{Evidence for the writer classifiers. Chance level for thirteen writers is 7.7\,\%. The two classifiers are complementary and neither is redundant: the ink classifier is the correct instrument for real photographs and the normalised classifier for drawn output}{table.caption.83}{}}
