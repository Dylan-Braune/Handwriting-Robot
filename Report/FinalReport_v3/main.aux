\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Line pitch, centres and seams. The smoothed row-ink profile on the right has one peak per line body; the median gap between peaks is the pitch $P$ and the suppressed peaks are the line centres $c_i$ (Equations~\ref {eq:seg-pitch} and~\ref {eq:seg-centres}). Each boundary between two centres is the least-cost path of Equation~\ref {eq:seg-seam}, which detours around the descender of the line above and the ascender of the line below (red) and relaxes to a straight line where the gap is empty (blue).}}{30}{figure.caption.32}\protected@file@percent }
\newlabel{fig:seg-chain}{{11}{30}{Line pitch, centres and seams. The smoothed row-ink profile on the right has one peak per line body; the median gap between peaks is the pitch $P$ and the suppressed peaks are the line centres $c_i$ (Equations~\ref {eq:seg-pitch} and~\ref {eq:seg-centres}). Each boundary between two centres is the least-cost path of Equation~\ref {eq:seg-seam}, which detours around the descender of the line above and the ascender of the line below (red) and relaxes to a straight line where the gap is empty (blue)}{figure.caption.32}{}}
