\@writefile{lot}{\contentsline {table}{\numberline {37}{\ignorespaces Hand-crafted style features prescribed for the correlation and retrieval of qualification test 1. The extractor that produced the measured correlation implements this set extended to the nine features listed in Table~\ref {tab:res-r1}.}}{121}{table.caption.140}\protected@file@percent }
\newlabel{tab:res-features}{{37}{121}{Hand-crafted style features prescribed for the correlation and retrieval of qualification test 1. The extractor that produced the measured correlation implements this set extended to the nine features listed in Table~\ref {tab:res-r1}}{table.caption.140}{}}
\@writefile{lot}{\contentsline {table}{\numberline {38}{\ignorespaces Results for qualification test 1 (measured on the development laptop). The writer count differs by row and is stated in each: the search-judge and real-handwriting rows cover all thirteen writers, whereas the style-correlation, overlay and independent-judge rows cover only the ten-writer harness subset, which omits the three weakest writers on the shape judge. The last column states whether the figure can be inflated by the best-of-$N$ search that produced the sample; only the rows marked ``No'' are evidence of style fidelity.}}{122}{table.caption.141}\protected@file@percent }
\newlabel{tab:res-r1}{{38}{122}{Results for qualification test 1 (measured on the development laptop). The writer count differs by row and is stated in each: the search-judge and real-handwriting rows cover all thirteen writers, whereas the style-correlation, overlay and independent-judge rows cover only the ten-writer harness subset, which omits the three weakest writers on the shape judge. The last column states whether the figure can be inflated by the best-of-$N$ search that produced the sample; only the rows marked ``No'' are evidence of style fidelity}{table.caption.141}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {43}{\ignorespaces Style-correlation test on nine geometric features extracted by one deterministic routine from held-out real pages and from synthesised lines, for the ten writers. Each panel is one feature; the axes are the writer means. Slant, ascender and character width track the real hand closely, whereas descender and the ascender-to-descender ratio do not, which is the same defect that the word-accuracy gap identifies.}}{123}{figure.caption.143}\protected@file@percent }
\newlabel{fig:res-features}{{43}{123}{Style-correlation test on nine geometric features extracted by one deterministic routine from held-out real pages and from synthesised lines, for the ten writers. Each panel is one feature; the axes are the writer means. Slant, ascender and character width track the real hand closely, whereas descender and the ascender-to-descender ratio do not, which is the same defect that the word-accuracy gap identifies}{figure.caption.143}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {44}{\ignorespaces Character accuracy of the synthesised text under the production recogniser and under a recogniser checkpoint that was not used to select the candidates. The independent judge scores the same output about three points lower, which quantifies how much of the apparent quality is a selection effect and simultaneously shows that the synthesis is genuinely legible rather than merely self-consistent.}}{124}{figure.caption.144}\protected@file@percent }
\newlabel{fig:res-judges}{{44}{124}{Character accuracy of the synthesised text under the production recogniser and under a recogniser checkpoint that was not used to select the candidates. The independent judge scores the same output about three points lower, which quantifies how much of the apparent quality is a selection effect and simultaneously shows that the synthesis is genuinely legible rather than merely self-consistent}{figure.caption.144}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {45}{\ignorespaces Measured accuracy against the target of each requirement. Targets are marked by the dashed vertical lines at 85\% (R1) and 95\% (R2). Green bars meet the target, amber bars lie within 1.5 points of it, and red bars fall below it. The two green R1 bars are the matching comparison on genuine handwriting and the writer classifier on real lines; the red synthesis bars are the values the system actually produces.}}{124}{figure.caption.145}\protected@file@percent }
\newlabel{fig:res-bars}{{45}{124}{Measured accuracy against the target of each requirement. Targets are marked by the dashed vertical lines at 85\% (R1) and 95\% (R2). Green bars meet the target, amber bars lie within 1.5 points of it, and red bars fall below it. The two green R1 bars are the matching comparison on genuine handwriting and the writer classifier on real lines; the red synthesis bars are the values the system actually produces}{figure.caption.145}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {46}{\ignorespaces Overlay test: for each text the writer's own handwriting and the system's synthesis of the same words are normalised to a common x-height and superimposed. Matched pairs are visibly closer than mismatched pairs, which is what the distance ratios and the rank-1 retrieval rate of 20\% (chance 10\%) measure. The procedure that produces these overlays is given as Figure~\ref {fig:res-overlay}.}}{125}{figure.caption.146}\protected@file@percent }
\newlabel{fig:res-overlay-examples}{{46}{125}{Overlay test: for each text the writer's own handwriting and the system's synthesis of the same words are normalised to a common x-height and superimposed. Matched pairs are visibly closer than mismatched pairs, which is what the distance ratios and the rank-1 retrieval rate of 20\% (chance 10\%) measure. The procedure that produces these overlays is given as Figure~\ref {fig:res-overlay}}{figure.caption.146}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {47}{\ignorespaces Matching comparison on identical sentences: genuine handwriting of the sentence against the system's synthesis of that same sentence, both read by the same recogniser. Character accuracy is close to the target, but word accuracy divides by more than a factor of 1.5, which shows that the synthesis preserves letterforms better than it preserves word boundaries and spacing.}}{126}{figure.caption.147}\protected@file@percent }
\newlabel{fig:res-matched}{{47}{126}{Matching comparison on identical sentences: genuine handwriting of the sentence against the system's synthesis of that same sentence, both read by the same recogniser. Character accuracy is close to the target, but word accuracy divides by more than a factor of 1.5, which shows that the synthesis preserves letterforms better than it preserves word boundaries and spacing}{figure.caption.147}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {48}{\ignorespaces End-to-end result per writer over all thirteen writers: writer identification and character accuracy, both measured through the G-code round trip, for three novel sentences per writer at best-of-8 (\texttt  {gcode\_v2\_summary.json}; shape judge \texttt  {author\_shape\_10new\_weights}, text judge \texttt  {paper\_cnn\_bilstm\_ctc\_joint\_best}). Ten of the thirteen writers are identified at 100\% by the shape judge; the remaining three are 150 at 33.3\% and Abhinav and Yeukita at 66.7\% each. The character-accuracy failures are concentrated in the two writers whose hands are the most joined, which is the known weak case of an exemplar synthesiser that cuts letters apart and reassembles them.}}{127}{figure.caption.148}\protected@file@percent }
\newlabel{fig:res-e2e}{{48}{127}{End-to-end result per writer over all thirteen writers: writer identification and character accuracy, both measured through the G-code round trip, for three novel sentences per writer at best-of-8 (\texttt {gcode\_v2\_summary.json}; shape judge \texttt {author\_shape\_10new\_weights}, text judge \texttt {paper\_cnn\_bilstm\_ctc\_joint\_best}). Ten of the thirteen writers are identified at 100\% by the shape judge; the remaining three are 150 at 33.3\% and Abhinav and Yeukita at 66.7\% each. The character-accuracy failures are concentrated in the two writers whose hands are the most joined, which is the known weak case of an exemplar synthesiser that cuts letters apart and reassembles them}{figure.caption.148}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {49}{\ignorespaces Writer-identification accuracy per writer over 1358 real lines, for the ink classifier and for the shape classifier before and after its training fault was corrected. The ink classifier is at or near 100\% for every writer. Correcting the shape classifier's training raised its overall accuracy from 83.4\% to 93.7\% and removed a systematic collapse in which 118 of Owen's 148 lines had been assigned to Yeukita. The dashed line is the 95\% target of R2.}}{127}{figure.caption.150}\protected@file@percent }
\newlabel{fig:res-writerid}{{49}{127}{Writer-identification accuracy per writer over 1358 real lines, for the ink classifier and for the shape classifier before and after its training fault was corrected. The ink classifier is at or near 100\% for every writer. Correcting the shape classifier's training raised its overall accuracy from 83.4\% to 93.7\% and removed a systematic collapse in which 118 of Owen's 148 lines had been assigned to Yeukita. The dashed line is the 95\% target of R2}{figure.caption.150}{}}
\@writefile{lot}{\contentsline {table}{\numberline {39}{\ignorespaces Results for qualification test 2 (13 writers; measured on the development laptop).}}{128}{table.caption.149}\protected@file@percent }
\newlabel{tab:res-r2}{{39}{128}{Results for qualification test 2 (13 writers; measured on the development laptop)}{table.caption.149}{}}
\@writefile{lot}{\contentsline {table}{\numberline {40}{\ignorespaces Results for qualification test 3 (development laptop; the writing figures are model values, not measurements).}}{128}{table.caption.151}\protected@file@percent }
\newlabel{tab:res-r3}{{40}{128}{Results for qualification test 3 (development laptop; the writing figures are model values, not measurements)}{table.caption.151}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {50}{\ignorespaces Reproduction time against the 4~s per character limit of R3. Left: synthesis time per character against sentence length for four values of the number of candidates. At best-of-1 and best-of-3 the synthesis alone is comfortably inside the limit; at best-of-30 it approaches and crosses it. Right: total time per character at best-of-14, decomposed into synthesis, G-code generation and the physical writing time predicted by the generator's model. The writing term, not the synthesis term, is the larger contributor and is what pushes the total past the limit.}}{129}{figure.caption.152}\protected@file@percent }
\newlabel{fig:res-r3}{{50}{129}{Reproduction time against the 4~s per character limit of R3. Left: synthesis time per character against sentence length for four values of the number of candidates. At best-of-1 and best-of-3 the synthesis alone is comfortably inside the limit; at best-of-30 it approaches and crosses it. Right: total time per character at best-of-14, decomposed into synthesis, G-code generation and the physical writing time predicted by the generator's model. The writing term, not the synthesis term, is the larger contributor and is what pushes the total past the limit}{figure.caption.152}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {51}{\ignorespaces Storage of the writing styles. Each writer is held as a style profile and the server lists all thirteen through its author-list endpoint, against the ten required by R6.}}{129}{figure.caption.155}\protected@file@percent }
