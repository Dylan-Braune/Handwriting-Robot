\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The five quantities every subsystem measures handwriting against. The x-height $x_{\mathrm  {h}}$ is the height of a lower-case letter with no tall part and no tail; an ascender reaches above it and a descender below the baseline. The ascender and descender reaches $A$ and $D$ are stored as multiples of $x_{\mathrm  {h}}$, so $A>1$ and $D<0$. The line pitch $P$ is the baseline-to-baseline distance and is the unit used by this block; $x_{\mathrm  {h}}$ is the unit used by every block after it.}}{22}{figure.caption.16}\protected@file@percent }
\newlabel{fig:seg-geom}{{7}{22}{The five quantities every subsystem measures handwriting against. The x-height $x_{\mathrm {h}}$ is the height of a lower-case letter with no tall part and no tail; an ascender reaches above it and a descender below the baseline. The ascender and descender reaches $A$ and $D$ are stored as multiples of $x_{\mathrm {h}}$, so $A>1$ and $D<0$. The line pitch $P$ is the baseline-to-baseline distance and is the unit used by this block; $x_{\mathrm {h}}$ is the unit used by every block after it}{figure.caption.16}{}}
\newlabel{eq:seg-resize}{{7}{22}{The geometry of a line of handwriting}{equation.7}{}}
\newlabel{eq:seg-clf}{{8}{22}{The geometry of a line of handwriting}{equation.8}{}}
