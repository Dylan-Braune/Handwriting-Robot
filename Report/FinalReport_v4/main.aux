\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces One direction of one LSTM layer as pseudocode, where $n=256$ is the hidden width and \texttt  {*} is element-wise multiplication. A step costs one matrix product for the input and one for the recurrent state. The tuple written to \texttt  {cache} is exactly what the backward pass needs, so no activation is recomputed when the gradient is propagated back through time; the bidirectional layer runs the same procedure on the reversed sequence and concatenates the two results.}}{115}{figure.caption.99}\protected@file@percent }
\newlabel{fig:rec-lstmpseudo}{{30}{115}{One direction of one LSTM layer as pseudocode, where $n=256$ is the hidden width and \texttt {*} is element-wise multiplication. A step costs one matrix product for the input and one for the recurrent state. The tuple written to \texttt {cache} is exactly what the backward pass needs, so no activation is recomputed when the gradient is propagated back through time; the bidirectional layer runs the same procedure on the reversed sequence and concatenates the two results}{figure.caption.99}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces Forward and backward pass of the two-dimensional convolution as pseudocode. The forward line is Equation~\ref {eq:rec-im2col}; \texttt  {dW}, \texttt  {dBias} and \texttt  {dCols} are its three gradients, and the double loop is the col2im scatter-add. The batch dimension is carried by one broadcast matrix product rather than a loop over samples, which was measured to be about 35\,\% faster for a realistic training batch.}}{115}{figure.caption.100}\protected@file@percent }
\newlabel{fig:rec-convpseudo}{{31}{115}{Forward and backward pass of the two-dimensional convolution as pseudocode. The forward line is Equation~\ref {eq:rec-im2col}; \texttt {dW}, \texttt {dBias} and \texttt {dCols} are its three gradients, and the double loop is the col2im scatter-add. The batch dimension is carried by one broadcast matrix product rather than a loop over samples, which was measured to be about 35\,\% faster for a realistic training batch}{figure.caption.100}{}}
