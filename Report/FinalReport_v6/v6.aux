\@writefile{lof}{\contentsline {figure}{\numberline {45}{\ignorespaces Distributions of the matched and mismatched overlay distances. The two distributions overlap but their means are separated by a factor of about 2.2 on the chamfer measure, giving an AUC of 0.71: the synthesis carries real writer information, but it is far from indistinguishable from the hand it imitates.}}{128}{figure.caption.128}\protected@file@percent }
\newlabel{fig:res-dist}{{45}{128}{Distributions of the matched and mismatched overlay distances. The two distributions overlap but their means are separated by a factor of about 2.2 on the chamfer measure, giving an AUC of 0.71: the synthesis carries real writer information, but it is far from indistinguishable from the hand it imitates}{figure.caption.128}{}}
