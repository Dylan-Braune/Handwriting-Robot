\@writefile{lof}{\contentsline {figure}{\numberline {38}{\ignorespaces The pitch measurement as pseudocode. The peak test is Equation~\ref {eq:seg-centres} and the median gap is the pitch $P$ of Equation~\ref {eq:seg-pitch}. The smoothed profile is returned as well and the caller reuses it for the line centres, so the scale unit and the line positions come out of one pass over the mask. The autocorrelation is a fallback only because it can lock onto a multiple of the true spacing.}}{100}{figure.caption.91}\protected@file@percent }
\newlabel{fig:seg-pitchpseudo}{{38}{100}{The pitch measurement as pseudocode. The peak test is Equation~\ref {eq:seg-centres} and the median gap is the pitch $P$ of Equation~\ref {eq:seg-pitch}. The smoothed profile is returned as well and the caller reuses it for the line centres, so the scale unit and the line positions come out of one pass over the mask. The autocorrelation is a fallback only because it can lock onto a multiple of the true spacing}{figure.caption.91}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {39}{\ignorespaces The least-ink seam as pseudocode. The cost field is Equation~\ref {eq:seg-cost2} and the loop over columns is the recursion of Equation~\ref {eq:seg-seam}. All rows of a column are evaluated at once as $2s+1$ shifted candidate arrays, so only the displacements and the backtrack are loops. At a weight of $4.0$ against a maximum of $0.012$, crossing one ink pixel costs over three hundred times more than sitting a half-gap from the midline, so the midline term only breaks ties over the gaps between words.}}{100}{figure.caption.92}\protected@file@percent }
\newlabel{fig:seg-seampseudo}{{39}{100}{The least-ink seam as pseudocode. The cost field is Equation~\ref {eq:seg-cost2} and the loop over columns is the recursion of Equation~\ref {eq:seg-seam}. All rows of a column are evaluated at once as $2s+1$ shifted candidate arrays, so only the displacements and the backtrack are loops. At a weight of $4.0$ against a maximum of $0.012$, crossing one ink pixel costs over three hundred times more than sitting a half-gap from the midline, so the midline term only breaks ties over the gaps between words}{figure.caption.92}{}}
