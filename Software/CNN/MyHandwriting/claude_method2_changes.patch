+def SelfConsensus(variants):
+    """Median shape descriptor of ONE author's own variants of one letter --
+    i.e. "how this writer forms this letter", learned only from themselves.
+
+    The cross-author prior (`_LETTER_PRIOR`) answers a different question:
+    "is this recognisably the letter at all", which is the right test for
+    REJECTING a broken cut but the wrong one for CHOOSING between good
+    variants -- ranking by it picks whichever of the author's letterforms
+    is closest to everyone else's, i.e. their least characteristic one."""
+    grids = [g for g in (_ShapeGrid(v) for v in variants) if g is not None]
+    if len(grids) < 2:
+        return None
+    proto = np.median(np.vstack(grids), axis=0)
+    n = float(np.linalg.norm(proto))
+    return proto / n if n > 1e-9 else None
+
+
+def _SelfScore(g, proto):
+    """Cosine distance from this variant to the author's own consensus."""
+    if proto is None:
+        return None
+    grid = _ShapeGrid(g)
+    if grid is None:
+        return None
+    return float(1.0 - np.dot(grid, proto))
+
